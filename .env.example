# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Private bucket name. Defaults to "receipts".
SUPABASE_RECEIPTS_BUCKET=receipts

# --- Database ---
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Direct (non-pooled) connection used by drizzle-kit migrations.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- AI extraction ---
OPENAI_API_KEY=sk-your-key
# Optional. Defaults to gpt-4o-2024-11-20.
OPENAI_RECEIPT_MODEL=gpt-4o-2024-11-20

# --- Queue runner ---
# Bearer token required by POST /api/internal/receipt-jobs.
RECEIPT_JOB_RUNNER_SECRET=generate-a-long-random-string

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
